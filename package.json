{
  "name": "@observertc/observer-js",
  "version": "1.0.0-beta.21",
  "description": "Server-side Node.js library for processing ObserveRTC Samples",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint -c .eslintrc.json \"src/**/*.ts\"",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.js",
    "test:coverage": "jest --config jest.config.js --coverage",
    "example": "ts-node --compiler-options '{\"module\":\"commonjs\"}' examples/sfu-observer.ts",
    "example:detectors": "ts-node --compiler-options '{\"module\":\"commonjs\"}' examples/detectors.ts",
    "bench": "ts-node --compiler-options '{\"module\":\"commonjs\"}' bench/detectors.bench.ts"
  },
  "keywords": [
    "webrtc",
    "observertc",
    "server",
    "integration"
  ],
  "author": "Balazs Kreith",
  "license": "Apache-2.0",
  "dependencies": {
    "@bufbuild/protobuf": "1.1.1",
    "events": "^3.3.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@tsconfig/node20": "^1.0.2",
    "@types/jest": "^27.5.2",
    "@types/node": "^20.9.0",
    "@typescript-eslint/eslint-plugin": "^5.38.0",
    "@typescript-eslint/parser": "^5.38.0",
    "eslint": "^8.24.0",
    "jest": "^27.5.0",
    "mediasoup": "^3.20.3",
    "prettier": "2.8.7",
    "ts-jest": "^27.1.5",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^4.8.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ObserveRTC/observer-js.git"
  },
  "peerDependencies": {
    "mediasoup": ">=3.11.0"
  },
  "peerDependenciesMeta": {
    "mediasoup": {
      "optional": true
    }
  }
}
